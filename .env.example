# Copy to .env and fill in what you use.

# Default backend: Groq free tier (no credit card). Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Pick the backend: groq (default), ollama (offline, local) or gemini
# ECHO_LLM_PROVIDER=groq
# ECHO_LLM_MODEL=openai/gpt-oss-120b

# Offline mode: brew install ollama && ollama pull qwen3.5:4b, then ECHO_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434

# Gemini free tier: key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Any other OpenAI-compatible endpoint
# ECHO_LLM_BASE_URL=
# ECHO_LLM_API_KEY=
